#!/usr/bin/env bash
set -euo pipefail

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if ! command -v uv >/dev/null 2>&1; then
    printf '%s\n' 'Linux Admin Lab needs uv: https://docs.astral.sh/uv/getting-started/installation/' >&2
    exit 1
fi

cd "$project_dir"
exec uv run labctl up "$@"
