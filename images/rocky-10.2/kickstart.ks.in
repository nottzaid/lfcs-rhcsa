# Linux Admin Lab Rocky Linux 10.2 golden image

text
cdrom
lang en_US.UTF-8
keyboard us
timezone Etc/UTC --utc

network --bootproto=dhcp --device=link --activate --hostname=lal-base.invalid

rootpw --lock
user --name=labadmin --groups=wheel --lock
firstboot --disable

selinux --enforcing
firewall --enabled --service=ssh
services --enabled=sshd,qemu-guest-agent,NetworkManager,firewalld,chronyd,cloud-init-local,cloud-init,cloud-config,cloud-final

zerombr
clearpart --all --initlabel
autopart --type=lvm
bootloader --append="console=tty0 console=ttyS0,115200n8"

shutdown

%packages
@^minimal-environment
389-ds-base
NetworkManager
acl
at
autofs
bind-utils
chrony
cloud-init
cloud-utils-growpart
createrepo_c
cronie
dnf-plugins-core
e2fsprogs
firewalld
git-core
haproxy
iproute
iscsi-initiator-utils
libvirt-client
libvirt-daemon-config-network
libvirt-daemon-kvm
lsof
lvm2
nginx
nfs-utils
nftables
openldap-clients
openssh-clients
openssh-server
openssl
perf
podman
policycoreutils-python-utils
python3
qemu-guest-agent
qemu-kvm
rsync
rpm-build
setools-console
sssd
sssd-tools
stress-ng
sudo
sysstat
targetcli
tcpdump
traceroute
tuned
virt-install
xfsprogs
%end

%post --erroronfail
cat > /etc/sudoers.d/90-linux-admin-lab <<'EOF'
labadmin ALL=(ALL) NOPASSWD: ALL
EOF
chmod 0440 /etc/sudoers.d/90-linux-admin-lab

mkdir -p /etc/ssh/sshd_config.d
cat > /etc/ssh/sshd_config.d/10-linux-admin-lab.conf <<'EOF'
PasswordAuthentication no
PermitRootLogin no
EOF

dnf clean all
cloud-init clean --logs --machine-id --seed
rm -f /var/lib/dbus/machine-id /etc/machine-id
touch /etc/machine-id
rm -f /etc/ssh/ssh_host_*
%end
